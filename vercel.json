{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "vynex/apps",
  "functions": {
    "api/vynex.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/vynex"
    },
    {
      "source": "/gta6/:path*",
      "destination": "/api/vynex"
    },
    {
      "source": "/",
      "destination": "/landing.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/cadastro",
      "destination": "/register.html"
    },
    {
      "source": "/app",
      "destination": "/studio.html"
    },
    {
      "source": "/app/",
      "destination": "/studio.html"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'self' https://*.private.blob.vercel-storage.com; img-src 'self' data: https://cf.shopee.com.br https://*.private.blob.vercel-storage.com; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
        }
      ]
    }
  ]
}