NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://betwin_user:betwin_pass@localhost:5432/betwin_db
REDIS_URL=redis://localhost:6379

# Betfair Configuration
BETFAIR_APP_ID=your-app-id-here
BETFAIR_CERT_PATH=/path/to/certificate.pem
BETFAIR_API_ENDPOINT=https://api.betfair.com/exchange

# JWT Configuration
JWT_SECRET=your-secret-key-here-minimum-32-characters-long!
JWT_EXPIRY=7d

# Paper Trading
PAPER_TRADING_ONLY=true
PAPER_TRADING_INITIAL_CAPITAL=10000

# Logging
LOG_LEVEL=info

# Monitoring
PROMETHEUS_PORT=9090

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
